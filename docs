🧩 6. Modelo de Dados (prisma/schema.prisma)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String
  requests  Request[]
}

model Category {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  defaultSlaHours Int
  subcategories   Subcategory[]
  requests        Request[]
}

model Subcategory {
  id          Int        @id @default(autoincrement())
  name        String
  categoryId  Int
  category    Category   @relation(fields: [categoryId], references: [id])
  requests    Request[]

  @@unique([name, categoryId])
}

model Request {
  id            Int        @id @default(autoincrement())
  code          String
  title         String
  description   String?
  status        String      @default("NEW")
  categoryId    Int
  subcategoryId Int
  requesterId   Int
  createdAt     DateTime    @default(now())

  category      Category    @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id])
  requester     User        @relation(fields: [requesterId], references: [id])
}

