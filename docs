🧩 9. Cliente Prisma (src/lib/db.ts)
import { PrismaClient } from "@prisma/client";

const globalForPrisma = global as unknown as { prisma: PrismaClient };

export const prisma =
  globalForPrisma.prisma ||
  new PrismaClient({
    log: ["warn", "error"],
  });

if (process.env.NODE_ENV !== "production") globalForPrisma.prisma = prisma;

🌐 10. API de Solicitações (src/app/api/requests/route.ts)

Endpoints disponíveis:

GET /api/requests

Retorna todas as solicitações.

POST /api/requests

Cria uma nova solicitação.

import { NextRequest, NextResponse } from "next/server";
import { prisma } from "@/src/lib/db";

export async function GET() {
  const data = await prisma.request.findMany({
    include: { category: true, subcategory: true, requester: true },
    orderBy: { createdAt: "desc" },
  });
  return NextResponse.json(data);
}

export async function POST(req: NextRequest) {
  const { title, description, categoryId, subcategoryId, requesterId } = await req.json();
  const count = await prisma.request.count();
  const code = `REQ-${new Date().getFullYear()}-${String(count + 1).padStart(5, "0")}`;

  const created = await prisma.request.create({
    data: {
      code,
      title,
      description,
      categoryId,
      subcategoryId,
      requesterId,
      status: "NEW",
    },
  });

  return NextResponse.json(created, { status: 201 });
}

🖥️ 11. Página /requests (Listagem)

src/app/requests/page.tsx

"use client";

import { useEffect, useState } from "react";

export default function RequestsPage() {
  const [requests, setRequests] = useState([]);

  useEffect(() => {
    fetch("/api/requests")
      .then((r) => r.json())
      .then(setRequests);
  }, []);

  return (
    <div className="p-8">
      <h1 className="text-2xl font-bold mb-6">Solicitações</h1>
      {requests.length === 0 ? (
        <p>Nenhuma solicitação encontrada.</p>
      ) : (
        <table className="min-w-full border border-gray-300">
          <thead>
            <tr className="bg-gray-100">
              <th className="p-2 text-left">Código</th>
              <th className="p-2 text-left">Título</th>
              <th className="p-2 text-left">Categoria</th>
              <th className="p-2 text-left">Status</th>
            </tr>
          </thead>
          <tbody>
            {requests.map((r: any) => (
              <tr key={r.id} className="border-t">
                <td className="p-2">{r.code}</td>
                <td className="p-2">{r.title}</td>
                <td className="p-2">{r.category?.name}</td>
                <td className="p-2">{r.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  );
}

